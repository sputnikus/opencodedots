{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.5",
  "small_model": "openai/gpt-5.4-mini",
  "plugin": [
    "oh-my-opencode-slim",
    //"@cortexkit/opencode-magic-context@latest",
    "opencode-mem",
  ],
  "lsp": true,
  "permission": {
    "plan_exit": "deny",
    "plan_enter": "deny",
  },
  "agent": {
    "plan": {
      "disable": true,
    },
    "explore": {
      "disable": true,
    },
    "general": {
      "disable": true,
    },
    "build": {
      "disable": true,
    },
    "planner": {
      "model": "openai/gpt-5.5",
      "variant": "high",
      "temperature": 0.1,
      "permission": {
        "edit": "ask",
        "bash": "deny",
        "plan_exit": "deny",
        "plan_enter": "deny",
      },
    },
  },
  "mcp": {
    "dbeaver": {
      "type": "local",
      "command": ["dbeaver-mcp-server"],
      "enabled": true,
      "environment": {
        "DBEAVER_READ_ONLY": "true",
      },
    },
    "linear": {
      "type": "local",
      "command": ["npx", "-y", "mcp-remote", "https://mcp.linear.app/mcp"],
      "enabled": true,
    },
    "notion": {
      "type": "remote",
      "url": "https://mcp.notion.com/mcp",
      "enabled": true,
    },
  },
  //"compaction": {
  //  "auto": false,
  //  "prune": false,
  //},
}
